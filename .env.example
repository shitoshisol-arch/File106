# FILE106 local public configuration. Copy to .env for local use.
# Do not put seed phrases or private keys in this file.

CLUSTER=devnet
# Backward-compatible alias. Prefer CLUSTER.
# SOLANA_CLUSTER=devnet

# Optional custom RPC URL. Leave empty to use the cluster default.
RPC_URL=

OWNER_KEYPAIR=./keys/owner-file106.json
MINT_KEYPAIR=./keys/mint-file106-token.json

# FILE106 cannot be a literal base58 suffix: I and 0 are both excluded from
# the Solana alphabet. FiLE is the closest valid visual match.
VANITY_SUFFIX=FiLE
MAX_VANITY_ATTEMPTS=2000000000

TOKEN_NAME=FILE106
TOKEN_SYMBOL=F106
TOKEN_DESCRIPTION="FILE106 is a fixed-supply Solana archive token: exactly 106 coins ever minted, 8 decimals. Classified. Decoded. Immutable."
TOKEN_LOGO_URI=https://gateway.pinata.cloud/ipfs/bafybeicl5gjlcbpxmbdiomezfv5afnkedwmzk3dizouamrs7td7ltp6vuq
# Must point to the hosted JSON metadata file, not the logo image.
TOKEN_METADATA_URI=https://example.com/FILE106.json
TOKEN_EXTERNAL_URL=https://gateway.pinata.cloud/ipfs/bafybeicl5gjlcbpxmbdiomezfv5afnkedwmzk3dizouamrs7td7ltp6vuq
TOKEN_SUPPLY=106
TOKEN_DECIMALS=8

# Mainnet guard. Keep false unless you are intentionally deploying to mainnet.
CONFIRM_MAINNET=false
# Authority revocation is a separate, explicit step. Keep false until the token
# has been inspected and you approve the revoke.
REVOKE_AFTER_MINT=false

# =====================================================================
# THE FILE106 ARCHIVE (VPS stack)
# Copy the values you need into .env on the server. Never commit .env.
# =====================================================================

# --- Postgres (read by docker-compose.yml) -----------------------------
POSTGRES_DB=file106
POSTGRES_USER=file106
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://file106:change-me-long-random@127.0.0.1:5432/file106

# --- Public origin / TLS ---------------------------------------------
SITE_DOMAIN=archive.example.com
SITE_ORIGIN=https://archive.example.com

# --- Application secrets ---------------------------------------------
# 64 hex characters each. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET signs session cookies.
SESSION_SECRET=
# ANSWER_ENC_KEY encrypts submitted answers (AES-256-GCM). Losing it makes
# pending submissions unreadable; leaking it does not leak the answers.
ANSWER_ENC_KEY=

# --- Solana (server-side only) ---------------------------------------
# The public mint. Verify it against the trust page before every deploy.
F106_MINT_ADDRESS=Ha6cqBCf5rCcka3M1BNK46BeBbZFbq5Mq1KgAjCmFiLE
F106_DECIMALS=8
# Use a dedicated RPC endpoint; the public one rate-limits balance checks.
ARCHIVE_RPC_URL=https://api.mainnet-beta.solana.com
ARCHIVE_COMMITMENT=confirmed
# Devnet switch for tests. Keep mainnet for production.
ARCHIVE_CLUSTER=mainnet-beta

# --- Email verification / password reset ------------------------------
# Left empty, verification links are printed to the server log instead of sent.
SMTP_URL=
MAIL_FROM=archive@example.com

# --- The archivist terminal (Stage 3) ---------------------------------
# Archivist sessions expire sooner than participant ones: this surface can seal
# answers and change what the public sees.
ADMIN_SESSION_TTL_HOURS=12
# Private exhibits. On the server this is the uploads_data volume; the directory
# must be writable by the app user and must be backed up with the database.
ARCHIVE_UPLOAD_DIR=var/uploads
ARCHIVE_UPLOAD_MAX_BYTES=8388608

# --- X follow verification (Stage 6) ----------------------------------
# Following a user cannot be verified without paid X API access. Leave these
# empty and X tasks run in manual review mode.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_ENABLED=false

# --- Telegram membership verification (Stage 6) -----------------------
# The bot must be an admin in the groups it checks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ENABLED=false

# --- Feature switches -------------------------------------------------
# Manual payout only: the server never holds a treasury key.
ALLOW_AUTOMATIC_PAYOUTS=false

