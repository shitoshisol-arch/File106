# FILE106 local public configuration. Copy to .env for local use.
# Do not put seed phrases or private keys in this file.

CLUSTER=devnet
# Backward-compatible alias. Prefer CLUSTER.
# SOLANA_CLUSTER=devnet

# Optional custom RPC URL. Leave empty to use the cluster default.
RPC_URL=

OWNER_KEYPAIR=./keys/owner-file106.json
MINT_KEYPAIR=./keys/mint-file106-token.json

# FILE106 cannot be a literal base58 suffix: I and 0 are both excluded from
# the Solana alphabet. FiLE is the closest valid visual match.
VANITY_SUFFIX=FiLE
MAX_VANITY_ATTEMPTS=2000000000

TOKEN_NAME=FILE106
TOKEN_SYMBOL=F106
TOKEN_DESCRIPTION="FILE106 is a fixed-supply Solana archive token: exactly 106 coins ever minted, 8 decimals. Classified. Decoded. Immutable."
TOKEN_LOGO_URI=https://gateway.pinata.cloud/ipfs/bafybeicl5gjlcbpxmbdiomezfv5afnkedwmzk3dizouamrs7td7ltp6vuq
# Must point to the hosted JSON metadata file, not the logo image.
TOKEN_METADATA_URI=https://example.com/FILE106.json
TOKEN_EXTERNAL_URL=https://gateway.pinata.cloud/ipfs/bafybeicl5gjlcbpxmbdiomezfv5afnkedwmzk3dizouamrs7td7ltp6vuq
TOKEN_SUPPLY=106
TOKEN_DECIMALS=8

# Mainnet guard. Keep false unless you are intentionally deploying to mainnet.
CONFIRM_MAINNET=false
# Authority revocation is a separate, explicit step. Keep false until the token
# has been inspected and you approve the revoke.
REVOKE_AFTER_MINT=false
